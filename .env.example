# Copy to .env and fill in. .env is gitignored -- never commit it.
#
# LLM keys are loaded globally from ~/.config/llm/.env, so they are not
# repeated here. This file is for values specific to this project.

# --- Shopify Admin API ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_atkn_ef03b48391dadeb919294289d87fdc1ada4f25c07b54c36435cfe390bb53cea2

# --- Shopify Storefront API (public, read-only) ---
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Webhooks ---
SHOPIFY_WEBHOOK_SECRET=

# --- App ---
NODE_ENV=development
PORT=3000
